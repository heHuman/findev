{
  "name": "@findev/producer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic market-data producer compiled to WebAssembly (AssemblyScript).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./producer.wasm": "./build/producer.wasm"
  },
  "scripts": {
    "build": "asc --config asconfig.json --target release",
    "build:debug": "asc --config asconfig.json --target debug",
    "typecheck": "tsc --noEmit -p src/tsconfig.json"
  },
  "devDependencies": {
    "assemblyscript": "^0.28.20",
    "typescript": "~6.0.3"
  }
}
