{
  "name": "@findev/dashboard",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build:wasm": "npm run build -w @findev/producer && node -e \"require('node:fs').copyFileSync('../../packages/producer/build/producer.wasm', 'public/producer.wasm')\"",
    "prestart": "npm run build:wasm",
    "start": "ng serve",
    "prebuild": "npm run build:wasm",
    "build": "ng build",
    "prewatch": "npm run build:wasm",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run build:wasm",
    "test": "ng test --watch=false"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.3",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@maskito/angular": "^5.6.0",
    "@maskito/core": "^5.6.0",
    "@maskito/kit": "^5.6.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
